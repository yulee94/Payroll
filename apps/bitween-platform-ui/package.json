{
  "name": "@bitween/platform-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Bitween cross-platform frontend shell built with React Native and TypeScript.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "check:strict-config": "node scripts/check-strict-config.js",
    "demo": "node scripts/run-demo-preview.mjs 4174",
    "preview": "node preview/server.js 4174",
    "preview:4174": "node preview/server.js 4174",
    "export:web": "expo export --platform web",
    "verify:data-mode": "node scripts/verify-runtime-data-mode.mjs",
    "verify:i18n": "node scripts/verify-i18n-catalog.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "^6.1.2",
    "expo": "^54.0.0",
    "expo-status-bar": "^3.0.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "^0.81.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "typescript": "^5.9.0"
  }
}
